# Copy to .env (git-ignored). `just` loads it for every recipe; the backend also reads .env from its working dir.

AGNOSTIC_ENV=development
AGNOSTIC_LOG__FORMAT=console
AGNOSTIC_LOG__LEVEL=INFO

# PostgreSQL from deploy/dev/compose.yml (production backend).
AGNOSTIC_DATABASE__URL=postgresql://agnostic:agnostic@localhost:5432/agnostic
# ...or SQLite for a dependency-light setup (jobs then run inside the API process, in memory):
# AGNOSTIC_DATABASE__URL=sqlite:///agnostic.db

AGNOSTIC_REDIS__URL=redis://localhost:6379/0

# Optional: export traces to an OTLP/HTTP collector.
# AGNOSTIC_OTEL__ENDPOINT=http://localhost:4318/v1/traces

# The URL people open in the browser: the Vite dev server, which proxies /api to :8000. Used for links in emails,
# SSO redirect URIs and as the issuer (iss) of the JWTs the runtimes verify (`just runtimes` passes it on).
AGNOSTIC_HTTP__PUBLIC_URL=http://localhost:5173

# Sessions and caches: auto = Redis on PostgreSQL, in-process on SQLite.
# AGNOSTIC_CACHE__MODE=auto

# Outgoing email (invitations, password resets) goes to Mailpit from the dev stack: http://localhost:8025.
# Without a URL, emails are written to the log instead.
AGNOSTIC_SMTP__URL=smtp://localhost:1025

# Encrypts instance private keys and other secrets at rest: base64 of 32 bytes. Unset, development uses a fixed
# insecure key and logs a warning; production refuses to start. Generate one with
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Changing it makes secrets sealed with the old key unreadable (reconnect the instances).
# AGNOSTIC_SECRETS__MASTER_KEY=
# Sign-in with GitHub, GitLab, Google, Okta or any OIDC provider: AGNOSTIC_IDENTITY__PROVIDERS__<ID>__*, see
# docs/how-to/sign-in-providers.md. Email + password sign-in is on by default (AGNOSTIC_IDENTITY__LOCAL_LOGIN).

# The dev Owner that `just bootstrap` creates and `just seed` signs in as (local login).
AGNOSTIC_DEV_OWNER_EMAIL=daniel@localhost.company
AGNOSTIC_DEV_OWNER_PASSWORD=localhost-dev-password
