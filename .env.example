# Copy to .env (git-ignored). `just` loads it for every recipe; the backend also reads .env from its working dir.

AGNOSTIC_ENV=development
AGNOSTIC_LOG__FORMAT=console
AGNOSTIC_LOG__LEVEL=INFO

# PostgreSQL from deploy/dev/compose.yml (production backend).
AGNOSTIC_DATABASE__URL=postgresql://agnostic:agnostic@localhost:5432/agnostic
# ...or SQLite for a dependency-light setup (jobs then run inside the API process, in memory):
# AGNOSTIC_DATABASE__URL=sqlite:///agnostic.db

AGNOSTIC_REDIS__URL=redis://localhost:6379/0

# Optional: export traces to an OTLP/HTTP collector.
# AGNOSTIC_OTEL__ENDPOINT=http://localhost:4318/v1/traces
