# Agnostic endpoint settings for deploy/compose. Every AGNOSTIC_* setting is described in
# docs/reference/configuration.md; run `docker compose run --rm api config check --connect` to verify them.

AGNOSTIC_ENV=production

# The agnostic image to run. No image is published: build it from the release tag (docs/guides/admin/build-images.md),
# then use the local tag or the reference in your own registry (e.g. registry.internal/agnostic:0.3.0).
AGNOSTIC_IMAGE=agnostic:0.3.0

# The URL people open in the browser (your reverse proxy). Used for links, SSO redirects and the JWT issuer.
AGNOSTIC_HTTP__PUBLIC_URL=https://agnostic.example.com

# PostgreSQL 17/18 with the citext and pg_trgm extensions available.
AGNOSTIC_DATABASE__URL=postgresql://agnostic:change-me@postgres.example.com:5432/agnostic
AGNOSTIC_DATABASE__SSLMODE=verify-full
# AGNOSTIC_DATABASE__TLS__CA_FILE=/run/secrets/postgres-ca.pem

# Redis 7.4+/8, Valkey 8+ or DragonflyDB 1.x (rediss:// for TLS; Sentinel: AGNOSTIC_REDIS__SENTINELS).
AGNOSTIC_REDIS__URL=rediss://:change-me@redis.example.com:6380/0

# Master key for secrets at rest: `docker compose run --rm api secrets generate-key`. Back it up: without it every
# stored secret (instance keys, IdP secrets, SIEM credentials) is lost. With a KMS, see docs/guides/admin/key-management.md.
AGNOSTIC_SECRETS__MASTER_KEY=
# AGNOSTIC_SECRETS__PROVIDER=vault
# AGNOSTIC_SECRETS__VAULT__ADDRESS=https://vault.example.com:8200

# Outgoing email (invitations, password resets). Without it, emails go to the log.
# AGNOSTIC_SMTP__URL=smtp://user:password@smtp.example.com:587
# AGNOSTIC_SMTP__SENDER=Agnostic <agnostic@example.com>

# Extra CA certificates trusted for outbound HTTPS (runtimes, IdPs, object storage, SIEM, KMS).
# AGNOSTIC_TLS__CA_FILE=/run/secrets/corporate-ca.pem

# Traces of the control plane itself (OTLP/HTTP).
# AGNOSTIC_OTEL__ENDPOINT=https://otel-collector.example.com:4318

# Protect /metrics with a bearer token (Prometheus `authorization` credentials).
# AGNOSTIC_METRICS__TOKEN=
