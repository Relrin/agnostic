{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Agnostic Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "workload": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "podDisruptionBudget": {
          "$ref": "#/definitions/pdb"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "config": {
      "type": "object",
      "description": "Non-secret AGNOSTIC_* settings (rendered into a ConfigMap).",
      "propertyNames": {
        "pattern": "^AGNOSTIC_[A-Z0-9_]+$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "AGNOSTIC_DATABASE__URL"
            ]
          },
          {
            "required": [
              "AGNOSTIC_REDIS__URL"
            ]
          },
          {
            "required": [
              "AGNOSTIC_SECRETS__MASTER_KEY"
            ]
          }
        ]
      }
    },
    "existingSecret": {
      "type": "string"
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraEnv": {
      "type": "array"
    },
    "extraSecretMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "secretName",
          "mountPath"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "secretName": {
            "type": "string"
          },
          "mountPath": {
            "type": "string"
          }
        }
      }
    },
    "api": {
      "$ref": "#/definitions/workload"
    },
    "worker": {
      "allOf": [
        {
          "$ref": "#/definitions/workload"
        },
        {
          "properties": {
            "concurrency": {
              "type": "integer",
              "minimum": 1
            },
            "queues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "controller": {
          "enum": [
            "nginx",
            "traefik",
            "none"
          ]
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "string"
              }
            }
          }
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array"
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dns": {
              "type": "boolean"
            },
            "endpoints": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "cidr",
                  "ports"
                ],
                "properties": {
                  "cidr": {
                    "type": "string"
                  },
                  "ports": {
                    "$ref": "#/definitions/ports"
                  }
                }
              }
            },
            "runtimes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "ports"
                ],
                "properties": {
                  "cidr": {
                    "type": "string"
                  },
                  "podSelector": {
                    "type": "object"
                  },
                  "namespaceSelector": {
                    "type": "object"
                  },
                  "ports": {
                    "$ref": "#/definitions/ports"
                  }
                }
              }
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "dataVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistentVolumeClaim": {
          "type": "string"
        },
        "sizeLimit": {
          "type": "string"
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
