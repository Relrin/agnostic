{
  "components": {
    "schemas": {
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "GreetingCreate": {
        "properties": {
          "message": {
            "examples": [
              "Hi from the control plane"
            ],
            "maxLength": 280,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "GreetingCreate",
        "type": "object"
      },
      "GreetingOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "examples": [
              "hel_01JBQ3Z7Y4W5V6X7Y8Z9A0B1C2"
            ],
            "pattern": "^hel_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "title": "Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "reply": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply"
          },
          "status": {
            "$ref": "#/components/schemas/GreetingStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "message",
          "status",
          "reply",
          "created_at",
          "updated_at"
        ],
        "title": "GreetingOut",
        "type": "object"
      },
      "GreetingStatus": {
        "enum": [
          "pending",
          "replied"
        ],
        "title": "GreetingStatus",
        "type": "string"
      },
      "Liveness": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Liveness",
        "type": "object"
      },
      "ModuleInfo": {
        "properties": {
          "audit_actions": {
            "items": {
              "type": "string"
            },
            "title": "Audit Actions",
            "type": "array"
          },
          "depends_on": {
            "items": {
              "type": "string"
            },
            "title": "Depends On",
            "type": "array"
          },
          "jobs": {
            "items": {
              "type": "string"
            },
            "title": "Jobs",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "depends_on",
          "scopes",
          "jobs",
          "audit_actions"
        ],
        "title": "ModuleInfo",
        "type": "object"
      },
      "Page_GreetingOut_": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/GreetingOut"
            },
            "title": "Data",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "total_estimate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Estimate"
          }
        },
        "required": [
          "data"
        ],
        "title": "Page[GreetingOut]",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "ReadinessCheck": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok",
          "detail"
        ],
        "title": "ReadinessCheck",
        "type": "object"
      },
      "SystemModules": {
        "properties": {
          "disabled": {
            "items": {
              "type": "string"
            },
            "title": "Disabled",
            "type": "array"
          },
          "enabled": {
            "items": {
              "$ref": "#/components/schemas/ModuleInfo"
            },
            "title": "Enabled",
            "type": "array"
          }
        },
        "required": [
          "enabled",
          "disabled"
        ],
        "title": "SystemModules",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Self-hosted control plane for Agno AgentOS",
    "title": "Agnostic",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/hello/greetings": {
      "get": {
        "operationId": "hello_list_greetings",
        "parameters": [
          {
            "description": "Maximum items to return",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Maximum items to return",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor from a previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor from a previous page",
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_GreetingOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Client error"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Server error"
          }
        },
        "summary": "List greetings, newest first",
        "tags": [
          "hello"
        ]
      },
      "post": {
        "operationId": "hello_create_greeting",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GreetingCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GreetingOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Client error"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Server error"
          }
        },
        "summary": "Create a greeting and queue its reply",
        "tags": [
          "hello"
        ]
      }
    },
    "/api/v1/hello/greetings/{greeting_id}": {
      "get": {
        "operationId": "hello_get_greeting",
        "parameters": [
          {
            "in": "path",
            "name": "greeting_id",
            "required": true,
            "schema": {
              "title": "Greeting Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GreetingOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Client error"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Server error"
          }
        },
        "summary": "Get one greeting",
        "tags": [
          "hello"
        ]
      }
    },
    "/api/v1/system/modules": {
      "get": {
        "operationId": "system_list_modules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemModules"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Client error"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Server error"
          }
        },
        "summary": "Enabled and disabled modules with what they contribute",
        "tags": [
          "system"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "system_liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "system"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "system_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readyz",
        "tags": [
          "system"
        ]
      }
    }
  }
}
