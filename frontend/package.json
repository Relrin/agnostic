{
  "name": "agnostic-frontend",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "dev": "yarn workspace @agnostic/web dev",
    "build": "yarn workspace @agnostic/web build",
    "typecheck": "tsc -b",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "yarn workspace @agnostic/ui storybook",
    "storybook:build": "yarn workspace @agnostic/ui storybook:build",
    "api:gen": "yarn workspace @agnostic/api gen",
    "e2e": "yarn workspace @agnostic/web e2e",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.5",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "resolutions": {
    "@hey-api/json-schema-ref-parser/js-yaml": "4.3.2",
    "@joshwooding/vite-plugin-react-docgen-typescript/glob": "14.0.3",
    "micromark-extension-math/katex": "0.19.1"
  }
}
